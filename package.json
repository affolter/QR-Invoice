{
  "name": "qr-invoice",
  "version": "0.1.1",
  "private": true,
  "description": "Browser-first Swiss QR-bill converter. Core has zero runtime npm deps; PDF is an optional adapter; CLI is optional.",
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/core",
    "packages/pdf",
    "packages/cli",
    "packages/server"
  ],
  "bin": {
    "invoice-converter": "./packages/cli/src/cli.js"
  },
  "exports": {
    ".": "./packages/core/src/index.js",
    "./pdf": "./packages/pdf/src/index.js"
  },
  "scripts": {
    "cli": "node packages/cli/src/cli.js",
    "web": "vite",
    "build": "vite build",
    "server": "node packages/server/src/serve.js",
    "test": "tsc -p jsconfig.json --noEmit && node --test packages/core/src/*.test.js packages/pdf/src/*.test.js packages/cli/src/*.test.js packages/server/src/*.test.js",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
