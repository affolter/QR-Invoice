{
  "name": "qr-invoice",
  "version": "0.1.1",
  "description": "Local CLI that normalizes Swiss Payments Code (SPC) text. Not a PDF or image reader.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "invoice-converter": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node src/cli.js",
    "test": "tsc -p jsconfig.json --noEmit && node --test src/*.test.js",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
