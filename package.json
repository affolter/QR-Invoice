{
  "name": "qr-invoice",
  "version": "0.1.1",
  "description": "Local CLI that normalizes Swiss Payments Code (SPC) text. Not a PDF or image reader.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "invoice-converter": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "cli": "node dist/cli.js",
    "test": "rm -rf dist && tsc -p tsconfig.json && node --test $(find dist -name '*.test.js')",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  }
}
