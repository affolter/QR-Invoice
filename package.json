{
  "name": "qr-invoice",
  "version": "0.1.1",
  "description": "Local CLI that normalizes a Swiss QR-bill. Accepts SPC text or a PDF with an embedded QR image.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "invoice-converter": "./src/cli.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./backend": "./src/backend.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "cli": "node src/cli.js",
    "test": "tsc -p jsconfig.json --noEmit && node --test src/*.test.js",
    "typecheck": "tsc -p jsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205",
    "qrcode": "^1.5.4"
  }
}
